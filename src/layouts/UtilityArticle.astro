---
import config from '../data/utilityArticles.json';
import Analytics from '../components/Analytics.astro';
const {post}=Astro.props;
const label='label' in config?String(config.label):config.domain;
const d=post.data;
const answer=d.answer??d.verdict;
const slug=d.slug??post.id.replace(/^en\//,'');
const canonical=config.origin+config.articlePrefix+slug+'/';
const published=new Date(d.publishDate??d.published).toISOString();
const checked=new Date(d.updatedDate??d.modified).toISOString();
const modified=checked>published?checked:published;
const date=(value:string)=>new Date(value).toLocaleDateString('en-US',{month:'long',day:'numeric',year:'numeric',timeZone:'UTC'});
const structured={'@context':'https://schema.org','@graph':[{'@type':'Article',headline:d.title,description:d.description,datePublished:published,dateModified:modified,inLanguage:'en',mainEntityOfPage:canonical,author:{'@type':'Organization',name:label+' editorial desk'},publisher:{'@type':'Organization',name:label,url:config.origin}}, {'@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Home',item:config.origin+config.homePath},{'@type':'ListItem',position:2,name:'Blog',item:config.origin+config.blogPath},{'@type':'ListItem',position:3,name:d.title,item:canonical}]}]};
---
<!doctype html>
<html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{d.title} | {label}</title><meta name="description" content={d.description}/><link rel="canonical" href={canonical}/><meta property="og:type" content="article"/><meta property="og:title" content={d.title}/><meta property="og:description" content={d.description}/><meta property="og:url" content={canonical}/><meta name="twitter:card" content="summary"/><meta property="article:published_time" content={published}/><meta property="article:modified_time" content={modified}/><link rel="icon" href="/favicon.svg"/><script type="application/ld+json" set:html={JSON.stringify(structured).replaceAll('<','\\u003c')}/>
<style is:inline>
body.utility-document{color-scheme:dark;--utility-paper:#11121c;--utility-ink:#edf0f7;--utility-muted:#b6bdd0;--utility-line:#303546;--utility-link:#c2b6ff}*{box-sizing:border-box}.utility-document{background:var(--utility-paper);color:var(--utility-ink)}.utility-document h1,.utility-document h2,.utility-document h3{color:var(--utility-ink);-webkit-text-fill-color:currentColor}.utility-document a{color:var(--utility-link)}body{margin:0;background:var(--utility-paper);color:var(--utility-ink);font:18px/1.8 system-ui,-apple-system,Segoe UI,sans-serif}a{color:var(--utility-link);text-underline-offset:.22em}a:hover{color:#fff}a:focus-visible{outline:3px solid #e1b4ff;outline-offset:5px}header,main,footer{max-width:920px;margin:auto;padding:24px}body.utility-document>header,body.utility-document>main,body.utility-document>footer{width:100%;max-width:920px;margin-left:auto;margin-right:auto}header{display:flex;justify-content:space-between;gap:24px;border-bottom:1px solid var(--utility-line)}header a{font-size:15px;text-decoration:none}main{padding-top:56px}.utility-crumb{font-size:14px;color:var(--utility-muted)}h1{font-size:clamp(32px,5.5vw,50px);line-height:1.17;letter-spacing:-.025em;margin:22px 0}h2{font-size:28px;line-height:1.3;margin-top:52px}h3{font-size:22px;line-height:1.4;margin-top:34px}.utility-description{font-size:21px;color:var(--utility-muted);line-height:1.6}.utility-byline{font-size:14px;color:var(--utility-muted);margin:24px 0 34px;padding-bottom:28px;border-bottom:1px solid var(--utility-line)}.utility-answer{border-left:3px solid #aa91ff;background:#1c1c2b;padding:20px 24px;margin:28px 0 38px}.utility-answer p{margin:6px 0 0}.utility-answer strong{font-size:14px;text-transform:uppercase;letter-spacing:.08em}.utility-prose{overflow-wrap:anywhere}.utility-prose p{margin:22px 0}.utility-prose li{margin:12px 0}.utility-prose table{display:block;overflow-x:auto;max-width:100%;border-collapse:collapse;font-size:16px;margin:30px 0}.utility-prose th,.utility-prose td{border:1px solid var(--utility-line);padding:14px;min-width:150px;text-align:left;vertical-align:top}.utility-prose th{background:#202235}.utility-prose pre{overflow-x:auto;white-space:pre;max-width:100%;padding:16px;background:#202235}.utility-prose code{font-size:.9em;background:#242638;border-radius:3px;padding:2px 5px}.utility-prose blockquote{border-left:3px solid var(--utility-line);margin:28px 0;padding:0 22px;color:var(--utility-muted)}.utility-sources{margin-top:48px;padding-top:4px;border-top:1px solid var(--utility-line)}.utility-sources ul{padding-left:23px}.utility-sources li{margin:12px 0;font-size:16px}.utility-sources p,footer{font-size:14px;color:var(--utility-muted)}footer{border-top:1px solid var(--utility-line);margin-top:48px;padding-bottom:40px}@media(max-width:600px){header,main,footer{padding-left:20px;padding-right:20px}main{padding-top:30px}body{font-size:17px}.utility-description{font-size:19px}h2{font-size:25px}.utility-answer{padding:16px 18px}ol,ul{padding-left:24px}}
</style></head><body class="utility-document"><header><a href={config.origin+config.homePath}>{label}</a><nav aria-label="Main"><a href={config.blogPath}>Blog</a></nav></header><main><nav class="utility-crumb" aria-label="Breadcrumb"><a href={config.homePath}>Home</a> / <a href={config.blogPath}>Blog</a> / Guide</nav><article><h1>{d.title}</h1><p class="utility-description">{d.description}</p><p class="utility-byline">{label} editorial desk · Published <time datetime={published}>{date(published)}</time><br/>Sources checked <time datetime={checked}>{date(checked)}</time></p><section class="utility-answer" aria-label="Quick answer"><strong>Quick answer</strong><p>{answer}</p></section><div class="utility-prose"><slot/></div><section class="utility-sources" id="sources"><h2>Sources and verification</h2><p>This guide distinguishes published documentation from examples and observations. Feature access, policies and account screens can change; the linked source governs its own terms.</p><ul>{d.sources.map((s:{name:string,url:string})=><li><a href={s.url} rel="noopener noreferrer">{s.name}</a></li>)}</ul></section></article></main><footer><a href={config.blogPath}>Back to the English blog</a><p>Independent informational guide. No claim of official support or account access.</p></footer><Analytics locale="en"/></body></html>
