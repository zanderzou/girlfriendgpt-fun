---
import Analytics from "../components/Analytics.astro";
import { getCollection } from "astro:content";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { site } from "../data/site";
import { localeList } from "../data/localized-girlfriendgpt";
import { localizedUi } from "../data/localized-ui";
import { languageAlternates, localeFromPath } from "../data/locale-routes";
import "../styles.css";
import "../localized.css";
interface Props { title:string; description:string; type?:"website"|"article"; keywords?:string[]; noindex?:boolean; publishedTime?:string; modifiedTime?:string; jsonLd?:Record<string,unknown>|Record<string,unknown>[]; }
const { title,description,type="website",keywords=[],noindex=false,publishedTime,modifiedTime,jsonLd }=Astro.props;
const canonical=new URL(Astro.url.pathname,site.url).toString();
const image = `${site.url}/assets/girlfriendgpt-user-selfie.jpg`;
const posts=(await getCollection("blog")).sort((a,b)=>b.data.publishDate.valueOf()-a.data.publishDate.valueOf());
const robots=noindex?"noindex,follow":"index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1";
const locale=localeFromPath(Astro.url.pathname);
const lang=locale==="en"?"en":localeList.find((entry)=>entry.slug===locale)!.code;
const ogLocales:Record<string,string>={en:"en_US",ja:"ja_JP",ko:"ko_KR","zh-hant":"zh_TW",es:"es_ES","pt-br":"pt_BR",ru:"ru_RU",de:"de_DE",fr:"fr_FR",ar:"ar_SA"};
const alternates=languageAlternates(Astro.url.pathname);
const skip=locale==="en"?"Skip to content":localizedUi[locale].method;
const socialAlt=locale==="en"?"GirlfriendGPT character research":localizedUi[locale].heroAlt;
---
<!doctype html><html lang={lang} dir={locale==="ar"?"rtl":"ltr"}><head><meta name="msvalidate.01" content="56B74B6B9E884918F4F18C05D7E2A1F4" /><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1.0"/><title>{title}</title><meta name="description" content={description}/><meta name="author" content={site.author}/>{keywords.length>0&&<meta name="keywords" content={keywords.join(", ")}/>}<meta name="robots" content={robots}/><meta name="googlebot" content={robots}/><meta name="bingbot" content={robots}/><link rel="canonical" href={canonical}/>{alternates.map((entry)=><link rel="alternate" hreflang={entry.code} href={entry.href}/>)}<link rel="alternate" type="application/rss+xml" title={`${site.name} RSS`} href="/rss.xml"/><link rel="icon" href="/favicon.svg" type="image/svg+xml"/><link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/><meta name="theme-color" content="#151418"/><meta property="og:type" content={type}/><meta property="og:site_name" content={site.name}/><meta property="og:locale" content={ogLocales[locale]}/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:image" content={image}/><meta property="og:image:alt" content={socialAlt}/><meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={title}/><meta name="twitter:description" content={description}/><meta name="twitter:image" content={image}/>{publishedTime&&<meta property="article:published_time" content={publishedTime}/>} {modifiedTime&&<meta property="article:modified_time" content={modifiedTime}/>} {jsonLd&&<script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>}</head><body><a class="skip-link" href="#main">{skip}</a><Header locale={locale}/><main id="main"><slot/></main><Footer posts={posts} locale={locale}/><script is:inline src="/assets/main.js"></script><Analytics locale={locale}/></body></html>
