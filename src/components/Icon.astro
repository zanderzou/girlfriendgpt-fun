---
type Name = "heart" | "spark" | "chat" | "lock" | "arrow" | "menu" | "wand";
interface Props { name: Name; }
const { name } = Astro.props;
---
<svg viewBox="0 0 24 24" aria-hidden="true">
  {name === "heart" && <path d="M20.8 4.7a5.5 5.5 0 0 0-7.8 0L12 5.8l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8l1.1 1.1L12 21l7.8-7.4 1.1-1.1a5.5 5.5 0 0 0-.1-7.8Z" />}
  {name === "spark" && <><path d="m12 2 1.6 5.4L19 9l-5.4 1.6L12 16l-1.6-5.4L5 9l5.4-1.6L12 2Z" /><path d="m19 15 .7 2.3 2.3.7-2.3.7L19 21l-.7-2.3L16 18l2.3-.7L19 15Z" /></>}
  {name === "chat" && <><path d="M4 5h16v11H8l-4 4V5Z" /><path d="M8 9h8M8 12h5" /></>}
  {name === "lock" && <><rect x="4" y="10" width="16" height="11" rx="3" /><path d="M8 10V7a4 4 0 0 1 8 0v3" /></>}
  {name === "arrow" && <path d="M5 12h14m-5-5 5 5-5 5" />}
  {name === "menu" && <path d="M4 7h16M4 12h16M4 17h16" />}
  {name === "wand" && <><path d="m15 4 5 5L9 20l-5-5L15 4Z" /><path d="m13 6 5 5M4 4v3M2.5 5.5h3M20 16v4M18 18h4" /></>}
</svg>
