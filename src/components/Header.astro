---
import Icon from "./Icon.astro";
import { site } from "../data/site";
import { localeList } from "../data/localized-girlfriendgpt";
import { localizedUi } from "../data/localized-ui";
import { isTranslatedRoute, localePath, type SiteLocale } from "../data/locale-routes";
const { locale="en" }=Astro.props as {locale?:SiteLocale};
const ui=locale==="en"?null:localizedUi[locale];
const base=locale==="en"?"/":`/${locale}/`;
const current=isTranslatedRoute(Astro.url.pathname)?Astro.url.pathname:"/";
const languages=[{code:"en",slug:"en",label:"English"},...localeList];
const navigation=locale==="en"?[
  ["How it works","/#how-it-works"],["Features","/#features"],["Compare","/#compare"],["Blog","/blog/"]
]:[[ui!.discover,`${base}#discover`],[ui!.method,`${base}#method`],[ui!.compare,`${base}#compare`],[ui!.blog,`${base}blog/`]];
---
<header class="site-header">
  <a class="brand" href={base} aria-label={ui?.home??"GirlfriendGPT home"}><span class="brand-icon">♥</span><strong>Girlfriend<span>GPT</span></strong></a>
  <nav aria-label={ui?.nav??"Main navigation"}>{navigation.map(([label,href])=><a href={href}>{label}</a>)}</nav>
  <div class="header-actions"><a class="official-link" href={site.officialUrl} rel="noopener" target="_blank">{ui?.official??"Visit official site"} <Icon name="arrow" /></a><details class="language-picker"><summary aria-label={ui?.language??"Choose language"}>🌐 {locale==="en"?"EN":localeList.find((entry)=>entry.slug===locale)?.code.toUpperCase()}</summary><div class="language-options">{languages.map((entry)=><a href={localePath(entry.slug as SiteLocale,current)} lang={entry.code} aria-current={locale===entry.slug?"page":undefined}>{entry.label}</a>)}</div></details></div>
  <button class="menu-button" type="button" aria-label={ui?.menu??"Open menu"} aria-expanded="false" data-menu-button><Icon name="menu" /></button>
  <div class="mobile-nav" data-mobile-nav>{navigation.map(([label,href])=><a href={href}>{label}</a>)}<a href={site.officialUrl} rel="noopener" target="_blank">{ui?.official??"Official GirlfriendGPT"}</a></div>
</header>
