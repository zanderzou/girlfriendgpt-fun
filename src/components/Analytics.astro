---
import { site } from "../data/site";
import { measurementId } from "../data/analytics";
interface Props { locale?: string; }
const domain = new URL(site.url).hostname;
---
{measurementId && <>
  <div id="site-analytics" data-measurement-id={measurementId} data-domain={domain} data-analytics-mode="automatic" hidden></div>
  <script is:inline defer src="/analytics-consent.js?v=20261007-auto"></script>
</>}
