---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { localeList, type LocaleSlug } from "../../data/localized-girlfriendgpt";
import { infoCopy, type InfoKey } from "../../data/localized-info";
import { localizedUi } from "../../data/localized-ui";
import { site } from "../../data/site";
export function getStaticPaths() { const infoKeys: InfoKey[] = ["about", "contact", "editorial-policy", "privacy", "terms"]; return localeList.flatMap((entry) => infoKeys.map((key) => ({ params: { locale: entry.slug, info: key }, props: { localeSlug: entry.slug, key } }))); }
const locale = Astro.props.localeSlug as LocaleSlug;
const key = Astro.props.key as InfoKey;
const copy = infoCopy[locale]![key];
const ui = localizedUi[locale];
const lang = localeList.find((entry) => entry.slug === locale)!.code;
const pageUrl = `${site.url}/${locale}/${key}/`;
const jsonLd = { "@context": "https://schema.org", "@type": "WebPage", name: copy.title, description: copy.description, url: pageUrl, inLanguage: lang, isPartOf: { "@id": `${site.url}/#website` } };
---
<BaseLayout title={copy.title} description={copy.description} jsonLd={jsonLd}><section class="info-hero locale-info-hero"><div class="ambient-orb"></div><span>GirlfriendGPT / {ui.information}</span><h1>{copy.title}</h1><p>{copy.description}</p></section><article class="info-content locale-info-content">{copy.sections.map(([heading, paragraphs]) => <section><h2>{heading}</h2>{paragraphs.map((paragraph) => <p>{paragraph}</p>)}</section>)}</article></BaseLayout>
