---
import{getCollection}from"astro:content";import BaseLayout from"../../layouts/BaseLayout.astro";import PostCard from"../../components/PostCard.astro";import{site}from"../../data/site";const posts=(await getCollection("blog")).sort((a,b)=>b.data.publishDate.valueOf()-a.data.publishDate.valueOf());const jsonLd={"@context":"https://schema.org","@type":"CollectionPage",name:"GirlfriendGPT comparisons and safety guides",url:`${site.url}/blog/`,description:"Independent GirlfriendGPT comparisons, safety checklists, and AI girlfriend research.",hasPart:posts.map((post)=>({"@type":"Article",headline:post.data.title,url:`${site.url}/blog/${post.id}/`,datePublished:post.data.publishDate.toISOString()}))};
---
<BaseLayout title="GirlfriendGPT Blog: Reviews, Comparisons & Safety" description="Independent GirlfriendGPT guides covering AI girlfriend chat, character creation, images, voice, privacy, pricing, Candy AI, CrushOn AI, and alternatives." keywords={["GirlfriendGPT blog","GirlfriendGPT review","GirlfriendGPT comparison","AI girlfriend alternatives","GirlfriendGPT safety"]} jsonLd={jsonLd}><section class="page-hero"><div class="ambient-orb"></div><span>GIRLFRIENDGPT RESEARCH LIBRARY</span><h1>Better conversations.<br/>Smarter comparisons.</h1><p>Original decision guides for GirlfriendGPT and the wider AI companion category—written for adults who want clear tradeoffs.</p></section><section class="section blog-list"><div class="post-grid">{posts.map((post,index)=><PostCard post={post} index={index}/>)}</div></section></BaseLayout>
