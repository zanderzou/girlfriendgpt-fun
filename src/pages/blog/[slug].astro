---
import{getCollection,render,type CollectionEntry}from"astro:content";import BaseLayout from"../../layouts/BaseLayout.astro";import PostCard from"../../components/PostCard.astro";import Icon from"../../components/Icon.astro";import{formatDate,site,toIsoDate}from"../../data/site";export async function getStaticPaths(){const posts=await getCollection("blog");return posts.map((post)=>({params:{slug:post.id},props:{post,posts}}));}interface Props{post:CollectionEntry<"blog">;posts:CollectionEntry<"blog">[]}const{post,posts}=Astro.props;const{Content}=await render(post);const related=posts.filter((item)=>item.id!==post.id).slice(0,2);const path=`/blog/${post.id}/`;const published=post.data.publishDate.toISOString();const modified=post.data.updatedDate.toISOString();const jsonLd={"@context":"https://schema.org","@graph":[{"@type":"Article",headline:post.data.title,description:post.data.description,datePublished:published,dateModified:modified,mainEntityOfPage:`${site.url}${path}`,image:`${site.url}/assets/girlfriendgpt-adult-swimwear-editorial.jpg`,author:{"@type":"Organization",name:site.author,url:`${site.url}/about/`},publisher:{"@type":"Organization",name:site.name,url:site.url,logo:{"@type":"ImageObject",url:`${site.url}/favicon.svg`}},about:post.data.keywords,inLanguage:"en"},{"@type":"BreadcrumbList",itemListElement:[{"@type":"ListItem",position:1,name:"Home",item:site.url},{"@type":"ListItem",position:2,name:"Blog",item:`${site.url}/blog/`},{"@type":"ListItem",position:3,name:post.data.title,item:`${site.url}${path}`}]}]};
---
<BaseLayout title={`${post.data.title} | GirlfriendGPT Guide`} description={post.data.description} type="article" keywords={post.data.keywords} publishedTime={published} modifiedTime={modified} jsonLd={jsonLd}><article class="article-shell"><header class="article-header"><nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><a href="/blog/">Blog</a><span>/</span><span>{post.data.category}</span></nav><a class="back-link" href="/blog/">← All GirlfriendGPT guides</a><div class="post-meta"><span>{post.data.category}</span><time datetime={toIsoDate(post.data.publishDate)}>{formatDate(post.data.publishDate)}</time><span>{post.data.readTime}</span></div><h1>{post.data.title}</h1><p>{post.data.description}</p><div class="byline"><span class="brand-icon">♥</span><div><strong>{site.author}</strong><small>Independent research · Reviewed {formatDate(post.data.updatedDate)}</small></div></div></header><div class="article-layout"><aside><div class="toc"><span>IN THIS GUIDE</span><a href="#answer">Direct answer</a><a href="#article-content">Full analysis</a><a href="#sources">Sources</a><a href="#related">Related reading</a></div></aside><div><section class="answer-box" id="answer"><span>DIRECT ANSWER</span><h2>What is the short version?</h2><p>{post.data.answer}</p></section><div class="article-content" id="article-content"><Content/></div><div class="editorial-rule"><div><Icon name="lock"/></div><div><strong>Our private-by-default rule</strong><p>Use fictional details, keep secrets out of chat, understand retention and billing, and never upload another person's image or voice without permission.</p></div></div><section class="sources" id="sources"><h2>Sources and verification</h2><p>Primary product pages and recognized privacy resources used to frame this independent guide. Recheck live features and prices before purchase.</p><ul>{post.data.sources.map((source)=><li><a href={source.url} rel="noopener" target="_blank">{source.name}</a></li>)}</ul></section></div></div></article><section class="section related" id="related"><div class="section-head"><div><div class="section-label">Continue exploring</div><h2>Related GirlfriendGPT<br/><span>guides.</span></h2></div></div><div class="post-grid compact">{related.map((item,index)=><PostCard post={item} index={index} compact/>)}</div></section></BaseLayout>
