---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import PostCard from "../components/PostCard.astro";
import { site } from "../data/site";
import heroImage from "../assets/girlfriendgpt-adult-swimwear-editorial.jpg";
const posts=(await getCollection("blog")).sort((a,b)=>b.data.publishDate.valueOf()-a.data.publishDate.valueOf());
const faqs=[
 {question:"What is GirlfriendGPT?",answer:"GirlfriendGPT is an adults-only AI companion platform for browsing or creating fictional characters, roleplay chat, AI images, voice interactions, and related creator content. Verify live features on the official product."},
 {question:"Is girlfriendgpt.fun the official website?",answer:"No. GirlfriendGPT Guide is an independent editorial publication. Official links open gptgirlfriend.online, which the provider identifies in its legal terms."},
 {question:"Can you create a custom AI girlfriend?",answer:"The official service currently promotes Create Character and Generate Image workflows. Test personality controls, greetings, memory, image consistency, and current credit limits before subscribing."},
 {question:"Is GirlfriendGPT free?",answer:"The product advertises a free starting route, but messages, media, voice, models, and adult features may have current limits. Review the live plan and checkout terms."},
 {question:"Which GirlfriendGPT alternatives should I compare?",answer:"Candy AI is a guided companion alternative, while CrushOn AI is a closer chat-first adult-roleplay comparison. Compare memory, customization, voice, images, moderation, privacy, and total cost."},
];
const jsonLd={"@context":"https://schema.org","@graph":[{"@type":"WebSite","@id":`${site.url}/#website`,name:site.name,url:site.url,description:site.description,inLanguage:"en"},{"@type":"Organization","@id":`${site.url}/#organization`,name:site.name,url:site.url,logo:`${site.url}/favicon.svg`},{"@type":"WebPage","@id":`${site.url}/#webpage`,name:"GirlfriendGPT Guide: AI Girlfriend Chat, Features & Alternatives",url:site.url,isPartOf:{"@id":`${site.url}/#website`},about:["GirlfriendGPT","AI girlfriend chat","AI companion","character creator","AI images"]},{"@type":"FAQPage",mainEntity:faqs.map((faq)=>({"@type":"Question",name:faq.question,acceptedAnswer:{"@type":"Answer",text:faq.answer}}))}]};
---
<BaseLayout title="GirlfriendGPT Guide: AI Girlfriend Chat & Alternatives" description={site.description} keywords={["GirlfriendGPT","GirlfriendGPT review","AI girlfriend chat","GirlfriendGPT alternatives","NSFW AI girlfriend","AI companion","GirlfriendGPT pricing"]} jsonLd={jsonLd}>
 <section class="hero"><Image class="hero-image" src={heroImage} alt="Adult woman in mint swimwear posing by the sea" widths={[640,960,1280,1536]} sizes="100vw" loading="eager" fetchpriority="high" quality={86}/><div class="hero-glow"></div><div class="hero-copy reveal"><div class="kicker">Independent GirlfriendGPT guide · Adults 18+</div><h1>Find a character.<span>Build the chemistry.</span></h1><p>Explore GirlfriendGPT chat, custom AI companions, roleplay, images, voice, privacy, pricing questions, and the alternatives worth testing.</p><div class="hero-actions"><a class="button primary" href="#how-it-works">Start the guide <Icon name="heart"/></a><a class="button ghost" href="/blog/girlfriendgpt-vs-candy-ai/">Compare Candy AI</a></div><div class="hero-trust"><span><Icon name="chat"/> Chat-first</span><span><Icon name="wand"/> Custom characters</span><span><Icon name="lock"/> Privacy-aware</span><span>Independent review</span></div></div><div class="chat-stack"><div class="chat-bubble"><small>CHARACTER INTRO</small><strong>“Pick the mood. I’ll set the scene.”</strong></div><div class="chat-bubble reply"><span>Playful · Confident · Fictional</span></div></div><div class="photo-credit">Photo: <a href="https://www.pexels.com/photo/11455873/" target="_blank" rel="noopener noreferrer">Fran Bertucci / Pexels</a> · no endorsement implied</div></section>
 <section class="section intent-grid"><div><div class="section-label">01 / Straight answer</div><h2>What does <span>GirlfriendGPT</span> do?</h2></div><div class="intent-copy"><p class="lead">GirlfriendGPT is an adult AI character platform built around companion chat, user-created personas, fictional roleplay, AI selfies or art, and voice-oriented interaction.</p><p>This guide helps you judge the product beyond its character cards: conversation quality, memory, creator controls, image consistency, voice, subscriptions, credits, privacy, deletion, and emotional boundaries.</p><div class="keyword-line"><span>GirlfriendGPT review</span><span>AI girlfriend chat</span><span>custom AI companion</span><span>NSFW AI roleplay</span><span>GirlfriendGPT alternatives</span></div></div></section>
 <section class="section journey" id="how-it-works"><div class="section-head"><div><div class="section-label">02 / How it works</div><h2>From discovery to<br/><span>your own character.</span></h2></div><p>The official experience centers on browsing community characters or creating a fictional companion, then extending chat into voice and media.</p></div><div class="journey-grid"><article><b>01</b><span>DISCOVER</span><h3>Browse a premise</h3><p>Look beyond the portrait. Check the greeting, creator notes, scenario, tags, and whether every depicted person is clearly adult.</p></article><article><b>02</b><span>CREATE</span><h3>Set personality & boundaries</h3><p>Use a fictional identity, one motivation, two compatible traits, and a greeting that gives the conversation somewhere to go.</p></article><article><b>03</b><span>TEST</span><h3>Check memory & cost</h3><p>Run a repeatable conversation test, then map paid messages, images, voice, or premium models to a weekly budget.</p></article></div></section>
 <section class="section" id="features"><div class="section-head"><div><div class="section-label">03 / Feature map</div><h2>More than a<br/><span>single chat box.</span></h2></div><p>GirlfriendGPT currently presents character discovery, creation, images, creator profiles, and adult roleplay as connected parts of the same product.</p></div><div class="feature-grid"><article class="feature reveal"><div class="feature-icon"><Icon name="chat"/></div><small>CONVERSATION</small><h3>AI girlfriend chat</h3><p>Test response initiative, personality stability, fictional memory, regeneration controls, and longer-scene continuity.</p><a href="/blog/girlfriendgpt-vs-crushon-ai/">Compare chat platforms <Icon name="arrow"/></a></article><article class="feature reveal"><div class="feature-icon"><Icon name="heart"/></div><small>PERSONALIZATION</small><h3>Create a character</h3><p>Shape an adult fictional companion's identity, tone, greeting, scenario, and boundaries without using real private details.</p><a href="#privacy">Build more privately <Icon name="arrow"/></a></article><article class="feature reveal"><div class="feature-icon"><Icon name="wand"/></div><small>MEDIA</small><h3>Images & voice</h3><p>Verify image consistency, voice controls, generation credits, failed-action charges, and deletion before upgrading.</p><a href="/blog/is-girlfriendgpt-safe/">Open the safety guide <Icon name="arrow"/></a></article></div></section>
 <section class="section story"><div class="story-board"><div class="match-card"><span>YOUR TEST PROFILE</span><h3>Alex / Neon Weekend</h3><div class="match-score"><b>3</b><small>things to test</small></div><ul><li>Does the voice stay consistent?</li><li>Can it recall a fictional detail?</li><li>What actions spend credits?</li></ul></div></div><div class="story-copy"><div class="section-label">04 / A fair 15-minute test</div><h2>Measure the experience,<br/><span>not the marketing.</span></h2><p>Use the same small scenario across every AI girlfriend service so memory, initiative, and cost are genuinely comparable.</p><ol class="steps"><li><span>01</span><div><strong>Introduce one fictional plan</strong><p>Choose a place and objective that contain no identifying information.</p></div></li><li><span>02</span><div><strong>Shift the conversation</strong><p>Move to another subject for several turns, then return to the plan.</p></div></li><li><span>03</span><div><strong>Score recall and initiative</strong><p>Record whether the character remembers, advances, contradicts, or merely agrees.</p></div></li></ol></div></section>
 <section class="section" id="compare"><div class="section-head"><div><div class="section-label">05 / Comparison snapshot</div><h2>GirlfriendGPT vs.<br/><span>AI companion alternatives.</span></h2></div><p>Choose according to the interaction you will actually use: open community discovery, guided companion design, or chat-first roleplay.</p></div><div class="compare-table"><table><thead><tr><th>Platform</th><th>Best fit</th><th>Creation style</th><th>Media emphasis</th><th>Guide</th></tr></thead><tbody><tr><td><strong>GirlfriendGPT</strong></td><td>Community characters and adult roleplay</td><td>Browse or create</td><td>Images and voice promoted</td><td><span class="badge">Creator-led</span></td></tr><tr><td><strong>Candy AI</strong></td><td>Guided companion customization</td><td>Curated setup</td><td>Images, voice, and video vary by plan</td><td><a href="/blog/girlfriendgpt-vs-candy-ai/">Full comparison →</a></td></tr><tr><td><strong>CrushOn AI</strong></td><td>Chat-first adult character roleplay</td><td>Community ecosystem</td><td>Conversation leads</td><td><a href="/blog/girlfriendgpt-vs-crushon-ai/"><span class="badge alt">Compare chat</span></a></td></tr></tbody></table></div></section>
 <section class="section privacy" id="privacy"><div class="privacy-copy"><div class="section-label">06 / Privacy before intimacy</div><h2>Make the character personal.<br/><span>Keep your identity fictional.</span></h2><p>Companion chat can invite sensitive disclosure. Use invented details, review storage and deletion controls, protect the account, and never upload a real person's intimate image without explicit permission.</p><a class="button ghost" href="/blog/is-girlfriendgpt-safe/">GirlfriendGPT safety checklist <Icon name="arrow"/></a></div><div class="privacy-card"><span>BEFORE YOU CHAT</span><h3>Five private-by-default habits</h3><ul><li><b>01</b><span>Use a unique password and fictional profile.</span></li><li><b>02</b><span>Keep addresses, work details, finances, and secrets out.</span></li><li><b>03</b><span>Check chat, media, and account deletion controls.</span></li><li><b>04</b><span>Confirm subscriptions, credits, renewal, and refunds.</span></li><li><b>05</b><span>Use clearly adult, consenting fictional scenarios only.</span></li></ul></div></section>
 <section class="section"><div class="section-head"><div><div class="section-label">07 / GirlfriendGPT blog</div><h2>Answers built for<br/><span>real decisions.</span></h2></div><a class="button ghost" href="/blog/">Browse all guides <Icon name="arrow"/></a></div><div class="post-grid">{posts.map((post,index)=><PostCard post={post} index={index}/>)}</div></section>
 <section class="section faq"><div><div class="section-label">08 / Frequently asked</div><h2>GirlfriendGPT<br/><span>questions, answered.</span></h2></div><div class="faq-list">{faqs.map((faq)=><details><summary>{faq.question}<span>+</span></summary><p>{faq.answer}</p></details>)}</div></section>
 <section class="section final-cta"><div><div class="section-label">COMPARE BEFORE YOU COMMIT</div><h2>Choose the companion<br/>that respects your boundaries.</h2><p>Test chat quality, privacy, moderation, media credits, and real weekly cost. Then verify current details on the official product.</p></div><a class="button primary" href={site.officialUrl} rel="noopener" target="_blank">Visit official GirlfriendGPT <Icon name="arrow"/></a></section>
</BaseLayout>
